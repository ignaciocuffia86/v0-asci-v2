{
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-dictionary",
      "schedule": "* * * * *"
    },

    {
      "path": "/api/cron/monitor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/sync-users",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * 0"
    }
  ]
}
