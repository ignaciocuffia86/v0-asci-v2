{
  "crons": [
    {
      "path": "/api/cron/process-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/process-dictionary",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/refresh-news",
      "schedule": "0 8 1,15 * *"
    },
    {
